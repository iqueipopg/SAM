# SAM — Systematic Agent for Meta-analysis
# Copy this file to .env and fill in your values.
# These override the equivalent settings in config.yaml.

# Required for PubMed/NCBI API access
ENTREZ_EMAIL=your-email@example.com

# Required for Unpaywall full-text retrieval
UNPAYWALL_EMAIL=your-email@example.com

# Optional: Semantic Scholar API key for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Optional: OpenAlex polite pool email
OPENALEX_EMAIL=

# Optional: The Lens API token (free from https://www.lens.org)
LENS_API_TOKEN=

# Optional: CORE API key (free from https://core.ac.uk)
CORE_API_KEY=
